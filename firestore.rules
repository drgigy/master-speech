rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['drgigy@gmail.com'];
    }

    match /adminSettings/{settingId} {
      allow read: if isAdmin() || request.auth != null;
      allow write: if isAdmin();
    }

    match /adminUserDirectory/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'email', 'lastSeenAt', 'addedAt', 'addedBy']));
      allow delete: if isAdmin();
    }

    match /adminUserFeatures/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
